# Copy to .env.local. Never commit .env.local.
# Random 32+ char string used to sign session cookies (required in production)
SESSION_SECRET=""
# Optional: custom SQLite path (default: ./data/statcheck.db)
# DB_PATH="./data/statcheck.db"
# Protects POST /api/cron/check — call it every minute from a scheduler
# (required in production, optional locally).
# CRON_SECRET=""
# 32-byte hex key for encrypted backups (scripts/backup.mjs). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACKUP_KEY=""
